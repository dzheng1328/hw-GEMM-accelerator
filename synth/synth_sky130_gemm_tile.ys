# synth/synth_sky130_gemm_tile.ys -- map the full self-sequencing tile
# (rtl/gemm_tile.v: operand_mem + gemm_sequencer + skew_feeder + 8x8 array)
# onto real sky130_fd_sc_hd standard cells for real area/timing numbers.
# Run from the repo root after ./synth/fetch_sky130.sh:
#
#   yosys synth/synth_sky130_gemm_tile.ys
#
# Expect this to take a while (the generic pass already showed ~58k cells for
# the bare array; the tile adds memory + control). abc -D 10000 targets 10 ns.
read_liberty -lib synth/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
read_verilog rtl/pe.v
read_verilog rtl/systolic_array.v
read_verilog rtl/skew_feeder.v
read_verilog rtl/tile.v
# rtl/operand_mem.v instantiates the real sky130_sram_512b_1rw_64x64 SRAM macro (issue #31/#32) by
# name twice (a_bank, b_bank). Yosys can't synthesize a real hard macro's internals -- it has no gate-
# level Verilog, only GDS/LEF/LIB views -- so synth/sram_blackbox.v provides a (* blackbox *) stub with
# a matching port list. `stat` below reports 0 area for the macro (blackboxes contribute no cells), so
# the real per-bank area from the macro's own generated LEF must be added back in by hand when reporting
# the tile's true total area -- see docs/decisions.md, issue #35 entry, for that arithmetic.
read_verilog synth/sram_blackbox.v
read_verilog rtl/operand_mem.v
read_verilog rtl/gemm_sequencer.v
read_verilog rtl/gemm_tile.v
synth -top gemm_tile
dfflibmap -liberty synth/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty synth/lib/sky130_fd_sc_hd__tt_025C_1v80.lib -D 10000
clean
tee -o synth/reports/gemm_tile_sky130.log stat -liberty synth/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
